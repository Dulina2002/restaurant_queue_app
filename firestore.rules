rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isManager() {
      return isRole('manager') || isAdmin();
    }

    function isStaff() {
      return isRole('receptionist') || isRole('staff') || isRole('host') || isManager();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Restaurants collection
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isManager();
    }

    // 3. Queue Entries collection
    match /queue_entries/{queueId} {
      allow read: if true;
      allow create: if true; // Customer online join or Receptionist walk-in
      allow update: if isStaff() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow delete: if isStaff();
    }

    // 4. Physical Tables collection
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isManager();
    }

    // 5. Menu Items collection
    match /menu_items/{dishId} {
      allow read: if true;
      allow write: if isManager();
    }

    // 6. Reservations collection
    match /reservations/{reservationId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isStaff());
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || (isSignedIn() && resource.data.user_id == request.auth.uid);
    }
  }
}
